# ===== Backend (Railway: api + worker services) =====
APP_ENV=development
# Supabase pooled connection string (transaction mode, port 6543), asyncpg format:
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification: use the JWKS URL (preferred) or the legacy JWT secret
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_MODELS_BUCKET=models

GEMINI_API_KEY=
# Flash-tier model approved by Argy on 2026-10-03 (re-check Google's model list before changing)
GEMINI_MODEL=gemini-3.8-flash
# Cost guard for Gemini: headlines per run (every 15 min), per request, and per UTC day
SENTIMENT_MAX_PER_RUN=40
SENTIMENT_BATCH_SIZE=20
SENTIMENT_MAX_PER_DAY=400
SENTIMENT_BLEND_K=0.0    # stays 0 (shadow mode) until evaluated, see docs/03

EXCHANGE=binance         # binance | bybit | okx | kraken
# Binance's market-data-only hosts (public, no key). api.binance.com is blocked on some networks.
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision
# News comes from public RSS feeds (backend/app/data/news/__init__.py): no key needed.
REDIS_URL=               # optional, phase 6 or later
FIREBASE_SERVICE_ACCOUNT_JSON=   # Railway variable holding the JSON, never a file in git
CORS_ORIGINS=http://localhost:3000
# Allows Vercel preview URLs of this project, e.g. ^https://tradematrix-[a-z0-9-]+-TEAM\.vercel\.app$
CORS_ORIGIN_REGEX=
# Sentry error tracking (api + worker). Empty = off.
SENTRY_DSN=

# ===== Web (Vercel) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Sentry for the web app (a DSN is safe to expose in the browser). Empty = off.
NEXT_PUBLIC_SENTRY_DSN=

# ===== Mobile (Flutter, passed with --dart-define) =====
# SUPABASE_URL, SUPABASE_ANON_KEY, API_BASE_URL, WS_URL
